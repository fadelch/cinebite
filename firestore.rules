rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // CineBite exposes no browser database access. Firebase Admin bypasses
    // these rules in the trusted server environment. Super Admin operations
    // are authorized by the Next.js server before Admin SDK access. Phase 5
    // tenant structure reads and writes remain parent-scoped server operations.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
