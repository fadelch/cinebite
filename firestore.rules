rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 2 exposes no browser database access. Firebase Admin bypasses these
    // rules in the trusted server environment. Authenticated client rules will
    // be introduced only when their authorization model is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
