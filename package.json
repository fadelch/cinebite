{
  "name": "cinebite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:security": "vitest run src/security",
    "test:seat-check-in": "tsx --conditions=react-server tests/security/seat-check-in.ts --local",
    "test:performance": "tsx --conditions=react-server tests/performance/run.ts --local",
    "test:performance:regression": "vitest run src/performance",
    "security:scan": "node scripts/security-scan.mjs",
    "verify:phase20": "tsx --conditions=react-server scripts/verify-phase-20.ts --local",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "tsx scripts/operations/migrate.ts",
    "ops:preflight": "tsx scripts/operations/preflight.ts",
    "ops:smoke": "tsx scripts/operations/smoke.ts",
    "test:staging": "node --env-file=.env.staging.local node_modules/tsx/dist/cli.mjs --conditions=react-server tests/staging/smoke.ts --confirm-staging-smoke",
    "test:operations": "tsx --conditions=react-server tests/operations/run.ts --local",
    "test:operations:browser": "tsx --conditions=react-server tests/operations/browser.ts --local",
    "ci:quality": "node scripts/operations/ci-environment.mjs scripts/operations/quality.mjs",
    "seed:phase9-demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed-phase-9-demo.ts",
    "bootstrap:super-admin": "tsx --conditions=react-server --env-file=.env.local scripts/bootstrap-super-admin.ts",
    "migrate:firestore-postgres": "tsx --conditions=react-server --env-file=.env.local scripts/migrate-firestore-postgres.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "motion": "^13.4.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion@<2": "^1.1.21",
    "brace-expansion@>=2 <3": "^2.1.7",
    "brace-expansion@>=4": "^5.0.12",
    "source-map-js": "^1.2.2",
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
