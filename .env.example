NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_ADMIN_PROJECT_ID=
# Paste the raw client_email value only; do not include JSON quotes or a comma.
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep this quoted when it contains escaped \n characters.
FIREBASE_ADMIN_PRIVATE_KEY=
# Server-only bucket name used by Firebase Admin Storage.
FIREBASE_STORAGE_BUCKET=
# Explicit false prevents all Admin Storage access, including QR image storage.
# Existing PostgreSQL QR image fallback remains available without a bucket.
# Existing development behavior is preserved when unset. Staging starts disabled.
CINEBITE_STORAGE_ENABLED=true

# Neon pooled connection for the running application.
DATABASE_URL=
# Neon direct connection for Prisma migration commands.
DIRECT_URL=

# Public origin encoded into server-generated seat QR codes.
# Use your deployed HTTPS origin in production, for example https://cinebite.example.com.
# For phone testing on the same Wi-Fi, use the computer's LAN origin, for example http://192.168.1.25:3000.
# Next.js also allows this hostname to load development assets.
CINEBITE_APP_ORIGIN=http://localhost:3000
# Optional guest-session policy overrides. Defaults: 15-minute cookie grace, 6-hour absolute maximum.
CUSTOMER_SESSION_GRACE_MINUTES=15
CUSTOMER_SESSION_MAX_HOURS=6

# Phase 14: no live-money adapter is installed. Explicit sandbox opt-in only.
# Keep disabled until configured; these are SERVER-only settings.
PAYMENT_PROVIDER=disabled
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_RESERVATION_MINUTES=12
# Server-only bearer token for a deployment scheduler (every minute).
PAYMENT_EXPIRY_JOB_SECRET=
# Notification outbox job: invoke POST /api/notifications/process with this
# server-only Bearer secret (at least 32 characters). No external adapter enabled.
NOTIFICATION_JOB_SECRET=

# Phase 19: server-only telemetry. No external monitoring/alert vendor is installed.
OBSERVABILITY_ENVIRONMENT=development
# Safe release label or commit SHA; never put a URL, key or credential here.
OBSERVABILITY_RELEASE=
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_SLOW_REQUEST_MS=2000
OBSERVABILITY_DB_DEGRADED_MS=500
OBSERVABILITY_BACKLOG_SECONDS=120
OBSERVABILITY_STUCK_SECONDS=900
OBSERVABILITY_JOB_STALE_SECONDS=300
# Dedicated bearer secret (at least 32 characters) for POST /api/operations/monitor.
OBSERVABILITY_JOB_SECRET=
## Phase 20 server-only security settings
# Exact browser origins, comma-separated. Include your LAN dev origin explicitly.
CINEBITE_ALLOWED_ORIGINS=
# Generate a random value of at least 32 characters; shared across app instances.
SECURITY_RATE_LIMIT_SECRET=
# Only true when your ingress overwrites the header and prevents origin bypass.
SECURITY_TRUST_PROXY=false
# Supported: x-real-ip or x-vercel-forwarded-for (single validated IP, never a chain).
SECURITY_CLIENT_IP_HEADER=
# Phase 21: per-instance driver pool, not a replacement for Neon's pooled URL.
DB_POOL_MAX=10
DB_QUERY_TIMEOUT_MS=10000
# Bounded outbox batch per invocation (1-100); existing deadline remains in force.
NOTIFICATION_BATCH_SIZE=25

# Phase 22: NODE_ENV stays development/test/production, never staging.
# Hosted builds REQUIRE pinned isolated resource identities; see the guide's
# explicit development-only exception when production does not exist yet.
# See docs/operations/STAGING_SETUP.md; do not paste URLs containing passwords into the registry.
CINEBITE_ENVIRONMENT=development
CINEBITE_RESOURCE_REGISTRY=
# Only set false if production really does not exist; staging then protects pinned development resources.
# Production still requires its own full registry entry and an isolated staging entry.
CINEBITE_PRODUCTION_CONFIGURED=
# disabled | external | vercel. Scheduling is NOT activated automatically.
CINEBITE_SCHEDULER=disabled
CRON_SECRET=
# A production migration operator supplies an ID of independently verified backup evidence.
# This value is not proof that a backup exists; reviewers must inspect the evidence.
CINEBITE_BACKUP_EVIDENCE_ID=
# Vercel Node 24 with the current Firebase Admin dependency chain requires
# NODE_OPTIONS=--experimental-require-module in the STAGING project settings.
# This is not a development default; preserve existing runtime options.
