generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipRole {
  CINEMA_ADMIN
  LOCATION_MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum HallStatus {
  ACTIVE
  INACTIVE
}

enum SeatStatus {
  ACTIVE
  DISABLED
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  ORGANIZATION_CREATED
  ORGANIZATION_SUSPENDED
  ORGANIZATION_REACTIVATED
  LOCATION_CREATED
  CINEMA_ADMIN_CREATED
  HALL_CREATED
  HALL_STATUS_CHANGED
  SEATS_GENERATED
  SEAT_DISABLED
  SEAT_ENABLED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DISABLED
  CATEGORY_ENABLED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DISABLED
  PRODUCT_ENABLED
  PRODUCT_IMAGE_UPDATED
  PRODUCT_IMAGE_REMOVED
  PRODUCT_LOCATION_ASSIGNED
  PRODUCT_LOCATION_PRICE_CHANGED
  PRODUCT_LOCATION_AVAILABILITY_CHANGED
}

enum AuditEntityType {
  ORGANIZATION
  LOCATION
  USER
  HALL
  SEAT
  MENU_CATEGORY
  PRODUCT
  PRODUCT_LOCATION
}

model User {
  id           String       @id @default(cuid())
  firebaseUid  String       @unique
  email        String       @unique
  displayName  String
  active       Boolean      @default(true)
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships OrganizationMembership[]
  auditLogs   AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships    OrganizationMembership[]
  locations      Location[]
  auditLogs      AuditLog[]
  menuCategories MenuCategory[]
  products       Product[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  allLocations   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationAccess LocationAccess[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model Location {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  slug           String
  addressLine1   String
  addressLine2   String?
  postalCode     String?
  city           String
  country        String
  timezone       String
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  halls            Hall[]
  access           LocationAccess[]
  auditLogs        AuditLog[]
  productLocations ProductLocation[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("locations")
}

model LocationAccess {
  membershipId   String
  locationId     String
  organizationId String

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  location   Location               @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
  @@index([organizationId])
  @@map("location_access")
}

model Hall {
  id         String     @id @default(cuid())
  locationId String
  name       String
  number     Int
  status     HallStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location  Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  seats     Seat[]
  auditLogs AuditLog[]

  @@unique([locationId, number])
  @@index([locationId])
  @@map("halls")
}

model Seat {
  id        String
  hallId    String
  row       String
  number    Int
  label     String
  status    SeatStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Restrict)

  @@id([hallId, id])
  @@unique([hallId, label])
  @@index([hallId])
  @@map("seats")
}

model MenuCategory {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         MenuStatus @default(ACTIVE)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status, sortOrder])
  @@map("menu_categories")
}

model Product {
  id               String     @id @default(cuid())
  organizationId   String
  categoryId       String
  name             String
  slug             String
  description      String
  sku              String?
  imageStoragePath String?
  imageUrl         String?
  status           MenuStatus @default(ACTIVE)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         MenuCategory      @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  productLocations ProductLocation[]

  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([categoryId, status, sortOrder])
  @@map("products")
}

model ProductLocation {
  id             String   @id @default(cuid())
  productId      String
  locationId     String
  organizationId String
  price          Decimal  @db.Decimal(12, 2)
  currencyCode   String   @db.Char(3)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product  Product  @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  location Location @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId, isAvailable])
  @@index([organizationId])
  @@map("product_locations")
}

model AuditLog {
  id             String          @id @default(cuid())
  actorUserId    String?
  action         AuditAction
  entityType     AuditEntityType
  entityId       String
  organizationId String?
  locationId     String?
  hallId         String?
  metadata       Json
  createdAt      DateTime        @default(now())

  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hall         Hall?         @relation(fields: [hallId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@index([hallId, createdAt])
  @@map("audit_logs")
}
