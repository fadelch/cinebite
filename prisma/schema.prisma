generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipRole {
  CINEMA_ADMIN
  LOCATION_MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum HallStatus {
  ACTIVE
  INACTIVE
}

enum SeatStatus {
  ACTIVE
  DISABLED
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum InventoryUnit {
  EACH
  GRAM
  MILLILITER
}

enum InventoryMovementType {
  RECEIVE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  ORDER_CONSUMPTION
}

enum MovieStatus {
  ACTIVE
  INACTIVE
}

enum ScreeningStatus {
  SCHEDULED
  CANCELLED
}

enum SeatQrStatus {
  ACTIVE
  REVOKED
}

enum CustomerSessionStatus {
  ACTIVE
  REVOKED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum OrderStatusActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum AuditAction {
  ORGANIZATION_CREATED
  ORGANIZATION_SUSPENDED
  ORGANIZATION_REACTIVATED
  LOCATION_CREATED
  CINEMA_ADMIN_CREATED
  HALL_CREATED
  HALL_STATUS_CHANGED
  SEATS_GENERATED
  SEAT_DISABLED
  SEAT_ENABLED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DISABLED
  CATEGORY_ENABLED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DISABLED
  PRODUCT_ENABLED
  PRODUCT_IMAGE_UPDATED
  PRODUCT_IMAGE_REMOVED
  PRODUCT_LOCATION_ASSIGNED
  PRODUCT_LOCATION_PRICE_CHANGED
  PRODUCT_LOCATION_AVAILABILITY_CHANGED
  INVENTORY_ITEM_CREATED
  INVENTORY_ITEM_UPDATED
  INVENTORY_ITEM_DISABLED
  INVENTORY_ITEM_ENABLED
  LOCATION_INVENTORY_CONFIGURED
  INVENTORY_STOCK_RECEIVED
  INVENTORY_ADJUSTMENT_IN
  INVENTORY_ADJUSTMENT_OUT
  INVENTORY_WASTE_RECORDED
  INVENTORY_THRESHOLD_CHANGED
  PRODUCT_RECIPE_COMPONENT_ADDED
  PRODUCT_RECIPE_COMPONENT_UPDATED
  PRODUCT_RECIPE_COMPONENT_REMOVED
  MOVIE_CREATED
  MOVIE_UPDATED
  MOVIE_ENABLED
  MOVIE_DISABLED
  MOVIE_POSTER_UPDATED
  MOVIE_POSTER_REMOVED
  SCREENING_CREATED
  SCREENING_UPDATED
  SCREENING_CANCELLED
  SEAT_QR_GENERATED
  SEAT_QR_ROTATED
  SEAT_QR_REVOKED
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING_STARTED
  ORDER_MARKED_READY
  ORDER_CLAIMED_FOR_DELIVERY
  ORDER_DELIVERED
}

enum AuditEntityType {
  ORGANIZATION
  LOCATION
  USER
  HALL
  SEAT
  MENU_CATEGORY
  PRODUCT
  PRODUCT_LOCATION
  INVENTORY_ITEM
  LOCATION_INVENTORY
  INVENTORY_MOVEMENT
  PRODUCT_RECIPE_COMPONENT
  MOVIE
  SCREENING
  SEAT_QR_CODE
  ORDER
}

model User {
  id           String       @id @default(cuid())
  firebaseUid  String       @unique
  email        String       @unique
  displayName  String
  active       Boolean      @default(true)
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships        OrganizationMembership[]
  auditLogs          AuditLog[]               @relation("AuditActor")
  inventoryMovements InventoryMovement[]      @relation("InventoryMovementActor")
  orderStatusEvents  OrderStatusEvent[]
  deliveryOrders    Order[] @relation("DeliveryAssignment")

  @@map("users")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships         OrganizationMembership[]
  locations           Location[]
  auditLogs           AuditLog[]
  menuCategories      MenuCategory[]
  products            Product[]
  inventoryItems      InventoryItem[]
  locationInventories LocationInventory[]
  inventoryMovements  InventoryMovement[]
  recipeComponents    ProductRecipeComponent[]
  movies              Movie[]
  orders              Order[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  allLocations   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationAccess LocationAccess[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model Location {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  slug           String
  addressLine1   String
  addressLine2   String?
  postalCode     String?
  city           String
  country        String
  timezone       String
  status         LocationStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  halls               Hall[]
  access              LocationAccess[]
  auditLogs           AuditLog[]
  productLocations    ProductLocation[]
  locationInventories LocationInventory[]
  orders              Order[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("locations")
}

model LocationAccess {
  membershipId   String
  locationId     String
  organizationId String

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  location   Location               @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
  @@index([organizationId])
  @@map("location_access")
}

model Hall {
  id         String     @id @default(cuid())
  locationId String
  name       String
  number     Int
  status     HallStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  location   Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  seats      Seat[]
  auditLogs  AuditLog[]
  screenings Screening[]
  orders     Order[]

  @@unique([locationId, number])
  @@index([locationId])
  @@map("halls")
}

model Seat {
  id        String
  hallId    String
  row       String
  number    Int
  label     String
  status    SeatStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  hall             Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  qrCode           SeatQrCode?
  customerSessions CustomerSession[]
  orders           Order[]

  @@id([hallId, id])
  @@unique([hallId, label])
  @@index([hallId])
  @@map("seats")
}

model MenuCategory {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         MenuStatus @default(ACTIVE)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status, sortOrder])
  @@map("menu_categories")
}

model Product {
  id               String     @id @default(cuid())
  organizationId   String
  categoryId       String
  name             String
  slug             String
  description      String
  sku              String?
  imageStoragePath String?
  imageUrl         String?
  status           MenuStatus @default(ACTIVE)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         MenuCategory             @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  productLocations ProductLocation[]
  recipeComponents ProductRecipeComponent[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([categoryId, status, sortOrder])
  @@map("products")
}

model ProductLocation {
  id             String   @id @default(cuid())
  productId      String
  locationId     String
  organizationId String
  price          Decimal  @db.Decimal(12, 2)
  currencyCode   String   @db.Char(3)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product  Product  @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  location Location @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId, isAvailable])
  @@index([organizationId])
  @@map("product_locations")
}

model InventoryItem {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  sku            String
  unit           InventoryUnit
  status         InventoryItemStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationInventories LocationInventory[]
  recipeComponents    ProductRecipeComponent[]

  @@unique([organizationId, sku])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
  @@map("inventory_items")
}

model LocationInventory {
  id                String   @id @default(cuid())
  organizationId    String
  locationId        String
  inventoryItemId   String
  quantityOnHand    Decimal  @default(0) @db.Decimal(14, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(14, 3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      Location            @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryItem InventoryItem       @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements     InventoryMovement[]

  @@unique([locationId, inventoryItemId])
  @@unique([id, organizationId])
  @@index([organizationId, locationId])
  @@index([inventoryItemId])
  @@map("location_inventory")
}

model InventoryMovement {
  id                  String                @id @default(cuid())
  organizationId      String
  locationInventoryId String
  type                InventoryMovementType
  quantityDelta       Decimal               @db.Decimal(14, 3)
  reason              String?
  note                String?
  actorUserId         String?
  orderId             String?
  createdAt           DateTime              @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationInventory LocationInventory @relation(fields: [locationInventoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor             User?             @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([locationInventoryId, createdAt])
  @@index([actorUserId])
  @@index([orderId])
  @@map("inventory_movements")
}

model ProductRecipeComponent {
  id               String   @id @default(cuid())
  organizationId   String
  productId        String
  inventoryItemId  String
  quantityRequired Decimal  @db.Decimal(14, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([productId, inventoryItemId])
  @@index([organizationId, productId])
  @@index([inventoryItemId])
  @@map("product_recipe_components")
}

model Movie {
  id                String      @id @default(cuid())
  organizationId    String
  title             String
  slug              String
  synopsis          String?
  durationMinutes   Int
  language          String?
  contentRating     String?
  status            MovieStatus @default(ACTIVE)
  posterStoragePath String?
  posterUrl         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  screenings   Screening[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status, title])
  @@map("movies")
}

model Screening {
  id        String          @id @default(cuid())
  movieId   String
  hallId    String
  startsAt  DateTime        @db.Timestamptz(3)
  endsAt    DateTime        @db.Timestamptz(3)
  status    ScreeningStatus @default(SCHEDULED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  movie            Movie             @relation(fields: [movieId], references: [id], onDelete: Restrict)
  hall             Hall              @relation(fields: [hallId], references: [id], onDelete: Restrict)
  customerSessions CustomerSession[]
  orders           Order[]

  @@index([hallId, status, startsAt])
  @@index([movieId, startsAt])
  @@map("screenings")
}

model SeatQrCode {
  id                 String       @id @default(cuid())
  hallId             String
  seatId             String
  tokenHash          String       @unique @db.Char(64)
  version            Int          @default(1)
  status             SeatQrStatus @default(ACTIVE)
  qrImageStoragePath String?
  qrImageData        Bytes?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  rotatedAt          DateTime?
  revokedAt          DateTime?

  seat Seat @relation(fields: [hallId, seatId], references: [hallId, id], onDelete: Restrict)

  @@unique([hallId, seatId])
  @@index([status, updatedAt])
  @@map("seat_qr_codes")
}

model CustomerSession {
  id          String                @id @default(cuid())
  tokenHash   String                @unique @db.Char(64)
  hallId      String
  seatId      String
  screeningId String
  status      CustomerSessionStatus @default(ACTIVE)
  expiresAt   DateTime              @db.Timestamptz(3)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  seat      Seat      @relation(fields: [hallId, seatId], references: [hallId, id], onDelete: Restrict)
  screening Screening @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  cart      Cart?
  orders    Order[]

  @@index([tokenHash, status])
  @@index([hallId, seatId, screeningId, status])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model Cart {
  id                String   @id @default(cuid())
  customerSessionId String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerSession CustomerSession @relation(fields: [customerSessionId], references: [id], onDelete: Restrict)
  items           CartItem[]

  @@map("carts")
}

model CartItem {
  id                   String   @id @default(cuid())
  cartId               String
  productId            String
  quantity             Int
  reviewedUnitPrice    Decimal  @db.Decimal(12, 2)
  reviewedCurrencyCode String   @db.Char(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                   String      @id @default(cuid())
  publicOrderCode      String      @unique
  customerSessionId    String
  organizationId       String
  locationId           String
  hallId               String
  seatId               String
  screeningId          String
  status               OrderStatus @default(PLACED)
  readyAt              DateTime?   @db.Timestamptz(3)
  deliveryAssignedUserId String?
  deliveryClaimedAt    DateTime?   @db.Timestamptz(3)
  deliveredAt          DateTime?   @db.Timestamptz(3)
  currencyCode         String      @db.Char(3)
  subtotal             Decimal     @db.Decimal(12, 2)
  total                Decimal     @db.Decimal(12, 2)
  customerNote         String?
  idempotencyKey       String
  locationNameSnapshot String
  hallNameSnapshot     String
  seatLabelSnapshot    String
  movieTitleSnapshot   String
  screeningStartsAt    DateTime    @db.Timestamptz(3)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  customerSession    CustomerSession     @relation(fields: [customerSessionId], references: [id], onDelete: Restrict)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location           Location            @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  hall               Hall                @relation(fields: [hallId], references: [id], onDelete: Restrict)
  seat               Seat                @relation(fields: [hallId, seatId], references: [hallId, id], onDelete: Restrict)
  screening          Screening           @relation(fields: [screeningId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  inventoryMovements InventoryMovement[]
  statusEvents       OrderStatusEvent[]
  deliveryAssignedUser User? @relation("DeliveryAssignment", fields: [deliveryAssignedUserId], references: [id], onDelete: Restrict)

  @@unique([customerSessionId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@index([screeningId, createdAt])
  @@index([locationId, status, createdAt])
  @@index([locationId, status, readyAt])
  @@index([deliveryAssignedUserId, status, deliveryClaimedAt])
  @@index([locationId, status, deliveredAt])
  @@map("orders")
}

model OrderStatusEvent {
  id          String               @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderStatusActorType
  actorUserId String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([orderId, toStatus])
  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_status_events")
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String
  productNameSnapshot  String
  productImageSnapshot String?
  unitPrice            Decimal  @db.Decimal(12, 2)
  currencyCode         String   @db.Char(3)
  quantity             Int
  lineTotal            Decimal  @db.Decimal(12, 2)
  createdAt            DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AuditLog {
  id             String          @id @default(cuid())
  actorUserId    String?
  action         AuditAction
  entityType     AuditEntityType
  entityId       String
  organizationId String?
  locationId     String?
  hallId         String?
  metadata       Json
  createdAt      DateTime        @default(now())

  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hall         Hall?         @relation(fields: [hallId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@index([hallId, createdAt])
  @@map("audit_logs")
}
